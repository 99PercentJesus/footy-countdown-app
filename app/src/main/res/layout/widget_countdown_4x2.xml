<?xml version="1.0" encoding="utf-8"?>
<!-- 3x2 & 4x2 Horizontal Widget: Full Crests + Team Names + Wide Uncropped Digital Clock -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/bg_widget"
    android:gravity="center"
    android:focusable="true"
    android:clickable="true">

    <!-- Active Match State -->
    <LinearLayout
        android:id="@+id/widget_state_match"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <!-- Optional Update Banner -->
        <TextView
            android:id="@+id/widget_update_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ NEW UPDATE PENDING · TAP TO INSTALL"
            android:textColor="#3DFF8C"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/bg_digit_block"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <!-- Top Row: Competition & Kickoff Datetime -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_comp_emblem"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_competition_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LALIGA"
                    android:textColor="#A0A8B6"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.06"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_kickoff_datetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAT 31 OCT · 20:00"
                android:textColor="#858D9C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.04"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Middle Row: Team vs Team with Crests and Names -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Home -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_home_crest"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="8dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_home_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Barcelona"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- VS -->
            <TextView
                android:id="@+id/widget_vs_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VS"
                android:textColor="#525866"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <!-- Away -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical|end">

                <TextView
                    android:id="@+id/widget_away_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alavés"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <ImageView
                    android:id="@+id/widget_away_crest"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Row: Unified Live Countdown Chronometer -->
        <!-- Fixed: textSize="21sp" with letterSpacing="0.02" guarantees 00:00:00 (Hours:Mins:Secs) NEVER gets dotted out on 3x2 -->
        <LinearLayout
            android:id="@+id/widget_blocks_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_digit_block"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center">

            <Chronometer
                android:id="@+id/widget_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="#3DFF8C"
                android:textSize="21sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:gravity="center"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/widget_chronometer_units"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL HOURS : MIN : SEC"
                android:textColor="#667085"
                android:textSize="9sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:letterSpacing="0.06" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_countdown_tag"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Live Container -->
        <LinearLayout
            android:id="@+id/widget_live_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_digit_block"
            android:padding="6dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_live_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IN PLAY · LIVE"
                android:textColor="#FF4D4D"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>
    </LinearLayout>

    <!-- State 2: No Fixture -->
    <LinearLayout
        android:id="@+id/widget_state_no_fixture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_no_fixture_team"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BARCELONA"
            android:textColor="#3DFF8C"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No fixture scheduled"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- State 3: Empty -->
    <LinearLayout
        android:id="@+id/widget_state_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Footy"
            android:textColor="#3DFF8C"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Select team"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</LinearLayout>
