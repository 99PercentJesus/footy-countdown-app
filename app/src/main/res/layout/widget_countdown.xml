<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_widget"
    android:gravity="center"
    android:focusable="true"
    android:clickable="true">

    <!-- STATE 1: ACTIVE MATCH COUNTDOWN (Clean, well-proportioned layout) -->
    <LinearLayout
        android:id="@+id/widget_state_match"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <!-- Top Row: Competition & Kickoff Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_comp_emblem"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_competition_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LALIGA"
                    android:textColor="#A0A8B6"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:ellipsize="end"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_kickoff_datetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUN 27 SEP · 21:00"
                android:textColor="#858D9C"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Middle Row: Team vs Team Facing Off -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <!-- Home Team (Left) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_home_crest"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/widget_home_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Barcelona"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:ellipsize="end"
                        android:singleLine="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOME"
                        android:textColor="#667085"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />
                </LinearLayout>
            </LinearLayout>

            <!-- VS Divider -->
            <TextView
                android:id="@+id/widget_vs_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:text="VS"
                android:textColor="#525866"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Away Team (Right) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical|end">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/widget_away_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Real Madrid"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:ellipsize="end"
                        android:singleLine="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AWAY"
                        android:textColor="#667085"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_away_crest"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Row: Unified Scoreboard Live Countdown Box -->
        <LinearLayout
            android:id="@+id/widget_blocks_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_digit_block"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center">

            <!-- Countdown Status Header -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢"
                    android:textSize="9sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/widget_countdown_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COUNTDOWN TO KICKOFF"
                    android:textColor="#A0A8B6"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <!-- Live Second-by-Second Ticking Chronometer -->
            <Chronometer
                android:id="@+id/widget_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:text="00:00:00"
                android:textColor="#3DFF8C"
                android:textSize="40sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.08" />

            <!-- Unit Labels (e.g. DAYS · HRS · MIN · SEC or HOURS : MIN : SEC) -->
            <TextView
                android:id="@+id/widget_chronometer_units"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAYS · HRS · MIN · SEC"
                android:textColor="#667085"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <!-- Live Match Ribbon (replaces countdown when in-play) -->
        <LinearLayout
            android:id="@+id/widget_live_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_digit_block"
            android:padding="8dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_live_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IN PLAY · SECOND HALF"
                android:textColor="#FF4D4D"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>
    </LinearLayout>

    <!-- STATE 2: NO FIXTURE SCHEDULED (Mockup 1h center) -->
    <LinearLayout
        android:id="@+id/widget_state_no_fixture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_no_fixture_team"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BARCELONA"
            android:textColor="#3DFF8C"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No fixture scheduled"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nothing on the calendar for the next 30 days. Footy will update the moment fixtures arrive."
            android:textColor="#858D9C"
            android:textSize="10sp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- STATE 3: NO TEAM PICKED YET (Mockup 1h bottom) -->
    <LinearLayout
        android:id="@+id/widget_state_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Footy"
            android:textColor="#3DFF8C"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Pick a team to follow"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to open Footy and choose your club or nation."
            android:textColor="#858D9C"
            android:textSize="10sp"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>
