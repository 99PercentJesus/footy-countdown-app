<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1 Horizontal Pill Widget: Crests on extreme ends, live ticking countdown in center -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/bg_widget_pill"
    android:gravity="center_vertical"
    android:focusable="true"
    android:clickable="true">

    <!-- Active Match State -->
    <LinearLayout
        android:id="@+id/widget_state_match"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="visible">

        <!-- Home Crest on Far Left -->
        <ImageView
            android:id="@+id/widget_home_crest"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:scaleType="fitCenter" />

        <!-- Center Ticking Live Countdown -->
        <LinearLayout
            android:id="@+id/widget_blocks_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Monospace Chronometer (Never wraps, fits cleanly) -->
            <Chronometer
                android:id="@+id/widget_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="#3DFF8C"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:gravity="center"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <!-- Live In-Play Status (replaces countdown when match is live) -->
        <LinearLayout
            android:id="@+id/widget_live_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_live_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IN PLAY · LIVE"
                android:textColor="#FF4D4D"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:gravity="center"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Away Crest on Far Right -->
        <ImageView
            android:id="@+id/widget_away_crest"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:scaleType="fitCenter" />

        <!-- Hidden views to safely satisfy unified binding -->
        <TextView
            android:id="@+id/widget_update_badge"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_competition_name"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_comp_emblem"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_kickoff_datetime"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_home_name"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_vs_label"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_away_name"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_countdown_tag"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_chronometer_units"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- State 2: No Fixture -->
    <LinearLayout
        android:id="@+id/widget_state_no_fixture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_no_fixture_team"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TEAM"
            android:textColor="#3DFF8C"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No fixture scheduled"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- State 3: Empty Pick Team -->
    <LinearLayout
        android:id="@+id/widget_state_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Footy"
            android:textColor="#3DFF8C"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="· Tap to pick a team"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
