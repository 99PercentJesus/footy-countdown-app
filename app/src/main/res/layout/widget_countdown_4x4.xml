<?xml version="1.0" encoding="utf-8"?>
<!-- 4x4 Large Showcase: Big Crests, Full Matchday Branding, Huge Stadium-Style Countdown Clock -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container_4x4"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_widget"
    android:gravity="center"
    android:focusable="true"
    android:clickable="true">

    <!-- Active Match State -->
    <LinearLayout
        android:id="@+id/widget_4x4_state_match"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <!-- Header: League emblem + Competition name + Kickoff Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_4x4_comp_emblem"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_4x4_competition_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LALIGA"
                    android:textColor="#A0A8B6"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_4x4_kickoff_datetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SAT 31 OCT · 20:00"
                android:textColor="#3DFF8C"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Huge Face-Off Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Home -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/widget_4x4_home_crest"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="8dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_4x4_home_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Barcelona"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOME"
                    android:textColor="#667085"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <!-- Big VS Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VS"
                    android:textColor="#3DFF8C"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Away -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/widget_4x4_away_crest"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="8dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_4x4_away_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alavés"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AWAY"
                    android:textColor="#667085"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>
        </LinearLayout>

        <!-- Stadium Style Giant Digital Clock -->
        <LinearLayout
            android:id="@+id/widget_4x4_blocks_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_digit_block"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:gravity="center">

            <!-- Tag -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢"
                    android:textSize="9sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/widget_4x4_countdown_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COUNTDOWN TO KICKOFF"
                    android:textColor="#A0A8B6"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>

            <Chronometer
                android:id="@+id/widget_4x4_chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="#3DFF8C"
                android:textSize="44sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/widget_4x4_chronometer_units"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL HOURS : MIN : SEC"
                android:textColor="#667085"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Live Container -->
        <LinearLayout
            android:id="@+id/widget_4x4_live_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_digit_block"
            android:padding="14dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_4x4_live_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IN PLAY · SECOND HALF"
                android:textColor="#FF4D4D"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>
    </LinearLayout>

    <!-- State 2: No Fixture -->
    <LinearLayout
        android:id="@+id/widget_4x4_state_no_fixture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_4x4_no_fixture_team"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BARCELONA"
            android:textColor="#3DFF8C"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No fixture scheduled"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nothing on the calendar for the next 30 days. Footy will automatically update the moment fixtures arrive."
            android:textColor="#858D9C"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />
    </LinearLayout>

    <!-- State 3: Empty -->
    <LinearLayout
        android:id="@+id/widget_4x4_state_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Footy"
            android:textColor="#3DFF8C"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Pick a team to follow"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>
